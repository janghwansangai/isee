{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 권한",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "updater:default",
    "process:allow-restart"
  ]
}
