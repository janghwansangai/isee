// iSee 소개·내려받기 사이트 (Cloudflare). site 폴더만 올린다: npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler@4.155.0/config-schema.json",
  "name": "isee-app",
  "compatibility_date": "2026-10-23",
  // 버전마다 생기는 미리 보기 주소는 쓰지 않는다 (예전 버전이 따로 열리지 않게)
  "preview_urls": false,
  "assets": {
    "directory": "./site"
  }
}
